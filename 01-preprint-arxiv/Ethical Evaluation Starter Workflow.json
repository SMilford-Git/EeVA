  "nodes": [
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item.json;\nconst binary = $input.item.binary;\n\n// Handle webhook binary data structure - file is in binary.file\nif (!binary || !binary.file) {\n  return { json: { validation_passed: false, error_message: 'No file uploaded', ...item }, binary };\n}\n\nconst file = binary.file;\nconst filename = file.fileName || 'unknown';\nconst mimetype = file.mimeType || '';\nconst fileSize = file.fileSize || 0;\n\n// Extract use_case_name from webhook body or query parameters\nconst use_case_name = item.body?.use_case_name || item.query?.use_case_name || '';\n\n// Support TXT, MD, and simple text-based PDF files\nconst allowedTypes = ['text/plain', 'text/markdown', 'application/pdf'];\nconst allowedExtensions = ['.txt', '.md', '.pdf'];\n\nconst hasValidMime = allowedTypes.includes(mimetype);\nconst hasValidExt = allowedExtensions.some(ext => filename.toLowerCase().endsWith(ext));\n\nif (!hasValidMime && !hasValidExt) {\n  return {\n    json: {\n      validation_passed: false,\n      error_message: 'Unsupported file type. This prototype supports TXT, MD, and simple text-based PDF files only.',\n      filename,\n      mimetype,\n      ...item\n    },\n    binary\n  };\n}\n\nconst maxSize = 16 * 1024 * 1024;\nif (fileSize > maxSize) {\n  return {\n    json: {\n      validation_passed: false,\n      error_message: `File size (${(fileSize / 1024 / 1024).toFixed(2)} MB) exceeds maximum allowed size of 16 MB.`,\n      filename,\n      fileSize,\n      ...item\n    },\n    binary\n  };\n}\n\nreturn { json: { validation_passed: true, filename, mimetype, fileSize, use_case_name, ...item }, binary };"
      },
